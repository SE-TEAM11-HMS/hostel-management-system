# Local HTTP development example. Do not use these values in deployment.
SECRET_KEY=replace-with-your-own-django-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# HTTPS and secure cookies are disabled here for local HTTP development.
# In deployment, configure them according to the HTTPS termination setup.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

DB_NAME=hostel_db
DB_USER=hostel_app
DB_PASSWORD=replace-with-your-own-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306
